# Copie para .env e ajuste. O .env NÃO é commitado.
# Endereço onde o servidor HTTP escuta.
ADDRESS=localhost:8080

# String de conexão do Postgres (mesmas credenciais do docker-compose.yml).
DATABASE_URL=postgres://forms:forms@localhost:5432/forms?sslmode=disable

# Segredo usado para assinar os tokens JWT. Troque em produção.
JWT_SECRET=dev-secret-troque-isto
