# Copie para .env e ajuste. O .env NÃO é commitado.
# Endereço onde o servidor HTTP escuta.
ADDRESS=localhost:8080

# String de conexão do Postgres (mesmas credenciais do docker-compose.yml).
DATABASE_URL=postgres://forms:forms@localhost:5432/forms?sslmode=disable

# Segredo usado para assinar os tokens JWT. Troque em produção.
JWT_SECRET=dev-secret-troque-isto

# Para onde a callback do Google devolve o navegador (origem do frontend).
FRONTEND_URL=http://localhost:5173

# Login com Google (opcional). Sem estas três variáveis o botão "Entrar com
# Google" não aparece e as rotas /auth/google respondem 503.
# Credenciais criadas em https://console.cloud.google.com/apis/credentials
# (tipo "Aplicativo da Web"). O redirect URI abaixo precisa estar
# registrado lá exatamente igual.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/auth/google/callback
